{
  "/": {
    "status": 200,
    "content": "<!DOCTYPE html>\n<html lang=\"km\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#4f46e5\">\n<link rel=\"manifest\" href=\"/manifest.json\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Voice Studio\">\n<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/icon-192.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"512x512\" href=\"/icon-512.png\">\n<meta name=\"description\" content=\"SRT Smart Voice Studio — ចុច ♂️/♀️ នៅពីមុខអក្សរក្នុង Editor ផ្ទាល់ ដើម្បីប្តូរតួអង្គភ្លាមៗ\">\n<title>SRT Smart Voice Studio v3 — Inline ♂️/♀️ Editor</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div class=\"wrap\">\n\n  <header>\n    <div class=\"head-actions\"><button class=\"icon-btn\" id=\"clear-cache-btn\" title=\"លុប Cache (Clear Cache)\">🔄</button><button class=\"icon-btn\" id=\"theme-btn\" title=\"ដូរ Theme\">🌙</button></div>\n    <h1>🎤 SRT Smart Voice Studio <span style=\"font-size:.55em;opacity:.8\">v3</span></h1>\n    <p>ចុចសញ្ញា <b>♂️ / ♀️ នៅពីមុខអក្សរ ក្នុងកន្លែងកែអត្ថបទផ្ទាល់</b> — ប្តូរតួអង្គភ្លាមៗនៅនឹងកន្លែង</p>\n    <div class=\"shield\">🛡️ <b>ទម្រង់ SRT មិនបាត់ទេ!</b> ពេលវេលា <span style=\"font-family:monospace\">00:00:01,000 --&gt; 00:00:04,000</span> នៅជាបន្ទាត់ប្រផេះពីលើក្រុមជួរ ហើយសញ្ញា ♂️/♀️ ត្រូវបានរក្សាជាមួយអត្ថបទគ្រប់ជួរ</div>\n  </header>\n\n  <!-- ================= EDITOR ================= -->\n  <section class=\"panel\">\n    <div class=\"row between\">\n      <h2><span class=\"step\">✎</span> កន្លែងកែអត្ថបទ</h2>\n      <div class=\"tabs\" role=\"tablist\">\n        <button id=\"tab-doc\" class=\"on\">✏️ កែជាជួរ (♂️/♀️)</button>\n        <button id=\"tab-raw\">&lt;/&gt; Raw SRT</button>\n      </div>\n    </div>\n    <p class=\"sub\">បិទភ្ជាប់ SRT នៅផ្ទាំង Raw រួចចុច «បំបែកចូល Editor» — បន្ទាប់មកកែនៅផ្ទាំង «កែជាជួរ»៖ <b>ចុចប៊ូតុង ♂️/♀️ នៅមុខអក្សរ = ប្តូរតួភ្លាម</b> • វាយអត្ថបទផ្ទាល់លើជួរ • ចុច <kbd>Enter</kbd> = បន្ថែមជួរថ្មី • ចុច badge <b>⚙️ 1.0x / 0</b> = បើក Pitch/Speed របស់ជួរនោះ</p>\n\n    <textarea id=\"raw\" placeholder=\"បិទភ្ជាប់អត្ថបទ SRT នៅទីនេះ...&#10;ឧទាហរណ៍៖&#10;1&#10;00:00:00,100 --> 00:00:06,400&#10;♀️ បង្ហាញការជូនដំណឹង&#10;♂️ សេរីភាពខាងការបញ្ចេញមតិ&#10;&#10;2&#10;00:00:07,560 --> 00:00:14,420&#10;♂️ បងស្រលាញ់អូន&#10;♀️ អូនស្រលាញ់បង\"></textarea>\n\n    <div id=\"doc\">\n      <div class=\"doc-hint\">👆 <b>ចុចលើសញ្ញា ♂️ / ♀️ នៅពីមុខអក្សរនីមួយៗ</b> ដើម្បីប្តូរតួប្រុស/ស្រីភ្លាមៗ នៅត្រង់កន្លែងកែនេះតែម្តង — ដូចរូបដែលអ្នកប្រាថ្នា។ បន្ទាត់ពណ៌ប្រផេះ <span style=\"font-family:monospace\">លេខ + ពេលវេលា</span> គឺជាទិន្នន័យ SRT ដែលត្រូវបានចាក់សោរការពារ មិនបាត់ឡើយ។</div>\n      <div id=\"doc-body\"></div>\n      <div class=\"empty-doc\" id=\"empty-doc\">\n        <div class=\"big\">📝</div>\n        <p><b>មិនទាន់មានអត្ថបទនៅក្នុង Editor ទេ</b></p>\n        <p style=\"font-size:12.5px\">ទៅផ្ទាំង <b>Raw SRT</b> បិទភ្ជាប់អត្ថបទ រួចចុច «✂️ បំបែកចូល Editor»<br>ឬចុចប៊ូតុងគំរូខាងក្រោមដើម្បីសាកល្បងសិន</p>\n      </div>\n    </div>\n\n    <div class=\"row between\" style=\"margin-top:12px\">\n      <div class=\"row\">\n        <button class=\"btn primary\" id=\"parse-btn\">✂️ បំបែកចូល Editor</button>\n        <label class=\"btn\" for=\"file-input\" style=\"margin:0\">📂 បើក .srt / .txt</label>\n        <input type=\"file\" id=\"file-input\" accept=\".srt,.txt,text/plain\" hidden>\n        <button class=\"btn\" id=\"sample-srt-btn\">🎬 គំរូ SRT</button>\n        <button class=\"btn\" id=\"sample-dialog-btn\">💬 គំរូសន្ទនា</button>\n        <label class=\"check auto-srt\" title=\"ពេល Parse SRT៖ អត្ថបទវែងនឹងត្រូវដាក់ Speed លឿនដោយស្វ័យប្រវត្តិ ដើម្បីឱ្យអានទាន់រយៈពេល Subtitle\"><input type=\"checkbox\" id=\"auto-speed-srt\" checked> ⚡ Auto Speed SRT (អត្ថបទវែង = លឿន)</label>\n      </div>\n      <div class=\"row\">\n        <span class=\"badge ok\" id=\"detect-badge\" style=\"display:none\"></span>\n        <button class=\"btn danger\" id=\"clear-btn\">🧹 Clear</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= BULK TOOLBAR ================= -->\n  <div class=\"toolbar\">\n    <div class=\"row between\">\n      <div class=\"row\">\n        <span class=\"badge\" id=\"stat-total\">📄 0 ជួរ</span>\n        <span class=\"badge\" id=\"stat-male\" style=\"background:var(--male-bg);color:var(--male-dark);border-color:var(--male-border)\">♂️ 0</span>\n        <span class=\"badge\" id=\"stat-female\" style=\"background:var(--female-bg);color:var(--female-dark);border-color:var(--female-border)\">♀️ 0</span>\n        <span class=\"badge warn\" id=\"stat-srt\">🛡️ SRT: —</span>\n      </div>\n      <div class=\"row\">\n        <button class=\"btn small\" id=\"setall-male\">♂️ ទាំងអស់</button>\n        <button class=\"btn small\" id=\"setall-female\">♀️ ទាំងអស់</button>\n        <button class=\"btn small\" id=\"alternate-btn\" title=\"ជួរ 1,3,5=♂️ / 2,4,6=♀️\">🔀 ឆ្លាស់គ្នា</button>\n        <button class=\"btn small\" id=\"swap-btn\">⇄ ប្តូរទាំងអស់</button>\n        <button class=\"btn small\" id=\"apply-auto-speed-btn\" title=\"គណនា Speed ឡើងវិញតាមចំនួនតួអក្សរ + រយៈពេល Subtitle\">⚡ គណនា Auto Speed</button>\n        <button class=\"btn small\" id=\"add-line-btn\">＋ ជួរ</button>\n        <button class=\"btn small primary\" id=\"add-block-btn\">＋ Block SRT</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ================= DEFAULTS ================= -->\n  <section class=\"panel\">\n    <h2><span class=\"step\">2</span> សំឡេងគោលរបស់តួអង្គ (Default Pitch / Speed)</h2>\n    <p class=\"sub\">ជួរនីមួយៗប្រើតម្លៃគោលនេះ លុះត្រាតែអ្នកបើក ⚙️ នៅលើជួរនោះ ហើយកែផ្ទាល់ (Custom)។</p>\n    <div class=\"voice-grid\">\n      <div class=\"voice-box male\">\n        <h3>♂️ Piseth — សំឡេងប្រុស</h3><div class=\"vn\">Edge TTS: km-KH-PisethNeural</div>\n        <div class=\"slider-line\" style=\"margin-top:8px\"><label>⚡ Speed <output id=\"def-piseth-speed-val\">1.0x</output></label>\n          <input type=\"range\" id=\"def-piseth-speed\" min=\"0.5\" max=\"2\" step=\"0.05\" value=\"1\"></div>\n        <div class=\"slider-line\" style=\"margin-top:8px\"><label>🎵 Pitch <output id=\"def-piseth-pitch-val\">0</output></label>\n          <input type=\"range\" id=\"def-piseth-pitch\" min=\"-10\" max=\"10\" step=\"1\" value=\"0\"></div>\n      </div>\n      <div class=\"voice-box female\">\n        <h3>♀️ Sreymom — សំឡេងស្រី</h3><div class=\"vn\">Edge TTS: km-KH-SreymomNeural</div>\n        <div class=\"slider-line\" style=\"margin-top:8px\"><label>⚡ Speed <output id=\"def-sreymom-speed-val\">1.0x</output></label>\n          <input type=\"range\" id=\"def-sreymom-speed\" min=\"0.5\" max=\"2\" step=\"0.05\" value=\"1\"></div>\n        <div class=\"slider-line\" style=\"margin-top:8px\"><label>🎵 Pitch <output id=\"def-sreymom-pitch-val\">0</output></label>\n          <input type=\"range\" id=\"def-sreymom-pitch\" min=\"-10\" max=\"10\" step=\"1\" value=\"0\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ================= GENERATE / EXPORT ================= -->\n  <section class=\"panel\">\n    <h2><span class=\"step\">3</span> ផលិតសំឡេង &amp; Export</h2>\n    <p class=\"sub\">Export SRT ទាញពេលវេលាចេញពីបន្ទាត់ប្រផេះលើ Editor — មិនបាត់ទម្រង់។ ជ្រើស SRT មាន Tag (♂️/♀️ នៅក្នុងអត្ថបទ) ឬ SRT ស្អាត (គ្មាន Tag) បាន។</p>\n    <button class=\"gen-btn\" id=\"generate-btn\">🎙️ ផលិតសំឡេង (Generate Audio)</button>\n    <div class=\"row\" style=\"margin-top:11px\">\n      <button class=\"btn\" id=\"play-all-btn\">▶️ ស្តាប់សាកល្បងទាំងអស់ (Browser)</button>\n      <button class=\"btn danger\" id=\"stop-btn\">⏹️ ឈប់</button>\n      <button class=\"btn\" id=\"auto-speed-btn\">⚡ <span id=\"auto-speed-text\">Auto Speed: OFF</span></button>\n    </div>\n    <div id=\"loader\"><div class=\"loader-spin\"></div><span>កំពុងផលិតសំឡេងពី Server (Edge TTS)... សូមរង់ចាំ</span></div>\n    <div id=\"status\"></div>\n    <div id=\"audio-box\">\n      <audio id=\"audio-player\" controls></audio>\n      <div style=\"margin-top:9px\"><a href=\"#\" id=\"download-link\" download=\"voice_combined.mp3\" style=\"font-weight:800;color:var(--indigo)\">⬇️ ទាញយកសំឡេង (MP3)</a></div>\n    </div>\n    <hr style=\"border:0;border-top:1px solid var(--border);margin:17px 0\">\n    <div class=\"row\">\n      <button class=\"btn primary\" id=\"dl-srt-btn\">⬇️ SRT ស្អាត (គ្មាន Tag)</button>\n      <button class=\"btn\" id=\"dl-srt-tag-btn\">⬇️ SRT មាន Tag ♂️/♀️</button>\n      <button class=\"btn\" id=\"copy-script-btn\">📋 Copy ស្គ្រីប TTS</button>\n      <button class=\"btn\" id=\"dl-json-btn\">⬇️ Segments JSON (Edge TTS)</button>\n      <button class=\"btn\" id=\"preview-btn\">👁️ មើលលទ្ធផល</button>\n    </div>\n    <pre id=\"preview\"></pre>\n  </section>\n\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/eruda/eruda.js\"></script>\n<script>if (window.eruda) { eruda.init(); }</script>\n<script src=\"script.js\"></script>\n</body>\n</html>\n"
  }
}